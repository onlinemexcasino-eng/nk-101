{
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/go",
      "destination": "https://seo666888.nk101.com/register.html",
      "permanent": false
    },
    {
      "source": "/go/",
      "destination": "https://seo666888.nk101.com/register.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
